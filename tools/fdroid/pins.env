# Pins for the F-Droid flavor native build. Sourced by lib.sh (bash).
APP_ID=com.zenithblue.nativecode.fdroid
# termux-packages: same commit FluxLinux builds on the F-Droid buildserver (July 14 2026).
TERMUX_PACKAGES_URL=https://github.com/termux/termux-packages.git
TERMUX_PACKAGES_REF=ebe0dcc596f9b79fc443ec61f769475136c834e6
# One NDK for everything (termux packages, fast_pty_guard, terminal-emulator libtermux.so).
NDK_VERSION=29.0.14206865
# proot: termux/proot commit + patches in patches/proot (same series as the Play libproot.so).
PROOT_COMMIT=7266fb3e8516535682f5a9c8f3a7e70f6506eddb
PROOT_ZIP_SHA256=f42fd559272a61fcaa48dbd153f16d3c58090c432c959c8919b4f990ebc91550
ARCH=aarch64
# termux/termux-x11 (libXlorie): last upstream commit before the :app -> :lorie reshuffle and the
# long-pointer JNI refactor (921d8bb); its LorieView/CmdEntryPoint native method set is identical to
# NativeCode's termux-x11/src/main/java (checked by tools/fdroid/check_jni.py). Submodule pins come
# from that commit's gitlinks (same as FluxLinux's).
TERMUX_X11_URL=https://github.com/termux/termux-x11.git
TERMUX_X11_COMMIT=caa7553b36c5567e19896ab6521a2cdcb8010014
# python's configure needs autoconf-archive (apt: autoconf-archive). Fetched into the work dir only
# when the host lacks it (non-Debian dev hosts); the F-Droid recipe installs the package instead.
AUTOCONF_ARCHIVE_URL=https://ftp.gnu.org/gnu/autoconf-archive/autoconf-archive-2023.02.20.tar.xz
AUTOCONF_ARCHIVE_SHA256=71d4048479ae28f1f5794619c3d72df9c01df49b1c628ef85fde37596dc31a33
