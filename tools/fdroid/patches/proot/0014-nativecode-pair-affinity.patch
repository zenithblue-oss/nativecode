+#ifndef NC_AFFINITY_H
+#define NC_AFFINITY_H
+
+#include "tracee/tracee.h"
+
+#ifdef NATIVECODE_PROOT_AFFINITY
+void nc_aff_on_stop(Tracee *tracee);      /* tracee reported an event */
+void nc_aff_on_resume(Tracee *tracee);    /* tracee was restarted */
+void nc_aff_forget(Tracee *tracee);       /* tracee is being destroyed */
+void nc_aff_guest_query(Tracee *target);  /* guest sched_getaffinity(target) */
+void nc_aff_guest_set(Tracee *target);    /* guest sched_setaffinity(target) */
+#else
+#define nc_aff_on_stop(t)     ((void) 0)
+#define nc_aff_on_resume(t)   ((void) 0)
+#define nc_aff_forget(t)      ((void) 0)
+#define nc_aff_guest_query(t) ((void) 0)
+#define nc_aff_guest_set(t)   ((void) 0)
+#endif
+
+#endif
