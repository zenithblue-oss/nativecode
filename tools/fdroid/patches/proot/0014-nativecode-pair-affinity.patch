diff --git a/src/tracee/affinity.c b/src/tracee/affinity.c
new file mode 100644
index 0000000..10d4d6e
--- /dev/null
+++ b/src/tracee/affinity.c
@@ -0,0 +1,398 @@
+/* NativeCode: co-locate syscall-dense tracees with the tracer.
+ *
+ * Every traced syscall is a tracee -> tracer -> tracee round trip.  When the
+ * two run on different CPUs each hop is a cross-CPU wake-up (idle exit, cold
+ * cache, low DVFS point); on big.LITTLE phones that costs 2-3x on
+ * metadata-heavy work (git, find, tar, npm).  A tracee that issues traced
+ * syscalls back to back is therefore pinned to the tracer's CPU, and released
+ * as soon as it goes quiet, so compute threads keep every core.
+ *
+ * The guest never observes the pin: sched_getaffinity(2) on a pinned tracee
+ * releases it first, and a tracee that calls sched_setaffinity(2) is never
+ * touched again.  Set PROOT_NO_AFFINITY=1 to disable.
+ */
+#ifdef NATIVECODE_PROOT_AFFINITY
+
+#define _GNU_SOURCE
+#include <sched.h>
+#include <pthread.h>
+#include <semaphore.h>
+#include <signal.h>
+#include <stdatomic.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+#include <errno.h>
+
+#include "tracee/tracee.h"
+#include "tracee/affinity.h"
+
+#define AFF_DENSE_GAP_NS  300000ULL   /* ran < 0.3 ms between two stops: dense */
+#define AFF_DENSE_EVENTS  16          /* consecutive dense stops before pinning */
+#define AFF_IDLE_NS       3000000ULL  /* pinned and silent for 3 ms: release */
+#define AFF_SWEEP_NS      2000000L    /* helper period while something is pinned */
+#define AFF_RETRY_NS      1000000000ULL
+#define AFF_SLOTS         128
+#define AFF_MAX_CPUS      64
+
+/* Slot word: generation (bumped on every pin) | state in the low 2 bits.
+ * The generation lets the helper's CAS fail when the slot was recycled
+ * after it read the tid.  RELEASING: the helper is restoring the mask.  */
+enum { SLOT_FREE = 0, SLOT_PINNED = 1, SLOT_RELEASED = 2, SLOT_RELEASING = 3 };
+#define ST(w)     ((w) & 3u)
+#define GEN(w)    ((w) & ~3u)
+#define GEN_STEP  4u
+
+typedef struct {
+	_Atomic unsigned state;
+	_Atomic pid_t tid;
+	_Atomic uint64_t resume_ns;   /* last restart */
+} Slot;
+
+static Slot slots[AFF_SLOTS];
+static _Atomic int pinned_count;
+static int state;                     /* 0: not initialised, 1: ready, -1: disabled */
+static int big_cpus[AFF_MAX_CPUS];
+static int big_count;
+static int pin_cpu = -1;
+static _Atomic bool tracer_pinned;
+static pid_t tracer_tid;
+static bool ever_pinned;
+static uint64_t retry_after_ns;
+static cpu_set_t all_cpus;
+static sem_t helper_sem;
+static bool helper_started;
+
+static uint64_t now_ns(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t) ts.tv_sec * 1000000000ULL + (uint64_t) ts.tv_nsec;
+}
+
+static int set_one(pid_t tid, int cpu)
+{
+	cpu_set_t set;
+	CPU_ZERO(&set);
+	CPU_SET(cpu, &set);
+	return sched_setaffinity(tid, sizeof(set), &set);
+}
+
+static void set_all(pid_t tid)
+{
+	(void) sched_setaffinity(tid, sizeof(all_cpus), &all_cpus);
+}
+
+/* Release pinned tracees that went quiet (computing, or blocked in the
+ * kernel): they produce no event, so the event loop cannot notice.  Touches
+ * nothing but the slot table, and sleeps while nothing is pinned.  */
+static void *helper_main(void *unused)
+{
+	const struct timespec period = { 0, AFF_SWEEP_NS };
+	(void) unused;
+
+	while (1) {
+		int active;
+
+		while (sem_wait(&helper_sem) < 0 && errno == EINTR)
+			;
+		do {
+			uint64_t now;
+			int i;
+
+			nanosleep(&period, NULL);
+			now = now_ns();
+			active = 0;
+			for (i = 0; i < AFF_SLOTS; i++) {
+				unsigned w = atomic_load(&slots[i].state);
+				uint64_t resumed;
+				pid_t tid;
+
+				if (ST(w) != SLOT_PINNED)
+					continue;
+				resumed = atomic_load(&slots[i].resume_ns);
+				tid = atomic_load(&slots[i].tid);
+				if (now < resumed || now - resumed < AFF_IDLE_NS) {
+					active++;
+					continue;
+				}
+				/* Fails if the slot was freed or recycled since
+				 * @w was read; forget_slot() waits out RELEASING.  */
+				if (atomic_compare_exchange_strong(&slots[i].state, &w, GEN(w) | SLOT_RELEASING)) {
+					set_all(tid);
+					atomic_store(&slots[i].state, GEN(w) | SLOT_RELEASED);
+				}
+			}
+		} while (active > 0);
+
+		/* Nothing left to pair with: give the tracer its CPUs back.
+		 * The event loop pins it again with the next dense tracee.  */
+		if (atomic_exchange(&tracer_pinned, false))
+			set_all(tracer_tid);
+	}
+	return NULL;
+}
+
+static void start_helper(void)
+{
+	sigset_t all, old;
+	pthread_attr_t attr;
+	pthread_t thread;
+
+	if (helper_started)
+		return;
+	helper_started = true;
+
+	if (sem_init(&helper_sem, 0, 0) < 0) {
+		state = -1;
+		return;
+	}
+	/* The helper must never run a tracer signal handler.  */
+	sigfillset(&all);
+	pthread_sigmask(SIG_BLOCK, &all, &old);
+	pthread_attr_init(&attr);
+	pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+	if (pthread_create(&thread, &attr, helper_main, NULL) != 0)
+		state = -1;
+	pthread_attr_destroy(&attr);
+	pthread_sigmask(SIG_SETMASK, &old, NULL);
+}
+
+static void init(void)
+{
+	cpu_set_t allowed;
+	long capacity[AFF_MAX_CPUS];
+	long max_capacity = 0;
+	int cpu;
+
+	state = -1;
+	if (getenv("PROOT_NO_AFFINITY") != NULL)
+		return;
+	if (sched_getaffinity(0, sizeof(allowed), &allowed) < 0 || CPU_COUNT(&allowed) < 2)
+		return;
+
+	for (cpu = 0; cpu < AFF_MAX_CPUS; cpu++) {
+		char path[64];
+		FILE *file;
+
+		capacity[cpu] = -1;
+		if (!CPU_ISSET(cpu, &allowed))
+			continue;
+		capacity[cpu] = 0;
+		snprintf(path, sizeof(path), "/sys/devices/system/cpu/cpu%d/cpu_capacity", cpu);
+		file = fopen(path, "r");
+		if (file != NULL) {
+			if (fscanf(file, "%ld", &capacity[cpu]) != 1)
+				capacity[cpu] = 0;
+			fclose(file);
+		}
+		if (capacity[cpu] > max_capacity)
+			max_capacity = capacity[cpu];
+	}
+
+	/* Fast cores only: one slow core is worse than no pinning.  Without
+	 * capacity information every allowed CPU is as good as another.  */
+	big_count = 0;
+	for (cpu = 0; cpu < AFF_MAX_CPUS; cpu++) {
+		if (capacity[cpu] < 0)
+			continue;
+		if (capacity[cpu] * 5 >= max_capacity * 4)
+			big_cpus[big_count++] = cpu;
+	}
+	if (big_count == 0)
+		return;
+
+	/* Restoring "every CPU" lets the kernel clamp to the current cpuset,
+	 * which Android changes behind our back (foreground/background).  */
+	memset(&all_cpus, 0xff, sizeof(all_cpus));
+
+	tracer_tid = gettid();
+	state = 1;
+	start_helper();   /* back to -1 on failure */
+}
+
+/* Pick the CPU for the next tracer pin: keep the tracer where the scheduler
+ * put it when that is a fast core, else spread tracers by pid.  */
+static int choose_cpu(void)
+{
+	int current = sched_getcpu();
+	int i;
+
+	for (i = 0; i < big_count; i++)
+		if (big_cpus[i] == current)
+			return current;
+	return big_cpus[(unsigned) getpid() % (unsigned) big_count];
+}
+
+static void unpin_tracer_if_idle(void)
+{
+	if (atomic_load(&pinned_count) == 0 && atomic_exchange(&tracer_pinned, false))
+		set_all(0);
+}
+
+static void forget_slot(Tracee *tracee)
+{
+	_Atomic unsigned *word = &slots[tracee->aff_slot].state;
+
+	/* Let an in-flight helper set_all() land first, so it cannot
+	 * override a mask installed after this (ours or the guest's).  */
+	for (;;) {
+		unsigned w = atomic_load(word);
+
+		if (ST(w) == SLOT_RELEASING)
+			sched_yield();
+		else if (atomic_compare_exchange_strong(word, &w, GEN(w) | SLOT_FREE))
+			break;
+	}
+	atomic_fetch_sub(&pinned_count, 1);
+	tracee->aff_pinned = false;
+	tracee->aff_dense = 0;
+}
+
+static void unpin(Tracee *tracee)
+{
+	if (!tracee->aff_pinned)
+		return;
+	forget_slot(tracee);
+	set_all(tracee->pid);
+	unpin_tracer_if_idle();
+}
+
+/* Book @tracee as pinned; @apply is false when the kernel mask is already
+ * the pin (inherited through clone(2)).  */
+static void pin(Tracee *tracee, bool apply, uint64_t now)
+{
+	int i;
+
+	if (!atomic_load(&tracer_pinned)) {
+		if (apply)
+			pin_cpu = choose_cpu();
+		if (pin_cpu < 0 || set_one(0, pin_cpu) < 0) {
+			retry_after_ns = now + AFF_RETRY_NS;
+			if (!apply)
+				set_all(tracee->pid);
+			return;
+		}
+		atomic_store(&tracer_pinned, true);
+	}
+
+	for (i = 0; i < AFF_SLOTS; i++)
+		if (ST(atomic_load(&slots[i].state)) == SLOT_FREE)
+			break;
+	if (i == AFF_SLOTS || (apply && set_one(tracee->pid, pin_cpu) < 0)) {
+		if (i != AFF_SLOTS)
+			retry_after_ns = now + AFF_RETRY_NS;
+		else if (!apply)
+			set_all(tracee->pid);
+		tracee->aff_dense = 0;
+		unpin_tracer_if_idle();
+		return;
+	}
+
+	atomic_store(&slots[i].tid, tracee->pid);
+	atomic_store(&slots[i].resume_ns, now);
+	atomic_store(&slots[i].state, (GEN(atomic_load(&slots[i].state)) + GEN_STEP) | SLOT_PINNED);
+	tracee->aff_slot = i;
+	tracee->aff_pinned = true;
+	ever_pinned = true;
+	atomic_fetch_add(&pinned_count, 1);
+	sem_post(&helper_sem);
+}
+
+void nc_aff_on_stop(Tracee *tracee)
+{
+	uint64_t now;
+	uint64_t gap;
+
+	if (state < 0 || tracee->aff_user)
+		return;
+	now = now_ns();
+
+	if (state == 0) {
+		init();
+		if (state != 1)
+			return;
+	}
+
+	/* A child created by a pinned tracee starts with the pinned mask:
+	 * adopt it, so that it is released like any other.  */
+	if (!tracee->aff_checked) {
+		tracee->aff_checked = true;
+		if (ever_pinned && !tracee->aff_pinned) {
+			cpu_set_t mask;
+			if (sched_getaffinity(tracee->pid, sizeof(mask), &mask) == 0
+			    && CPU_COUNT(&mask) == 1) {
+				if (CPU_ISSET(pin_cpu, &mask))
+					pin(tracee, false, now);
+				else   /* the pin moved since its parent forked */
+					set_all(tracee->pid);
+			}
+		}
+	}
+
+	if (tracee->aff_pinned) {
+		Slot *slot = &slots[tracee->aff_slot];
+
+		if (ST(atomic_load(&slot->state)) != SLOT_PINNED) {
+			/* The helper let it go (or is doing so).  */
+			unpin(tracee);
+		} else if (!atomic_load(&tracer_pinned) && set_one(0, pin_cpu) == 0) {
+			/* The helper released the tracer just before this
+			 * tracee was pinned.  */
+			atomic_store(&tracer_pinned, true);
+		}
+	}
+
+	gap = tracee->aff_resume_ns != 0 && now > tracee->aff_resume_ns
+		? now - tracee->aff_resume_ns : UINT64_MAX;
+	if (gap < AFF_DENSE_GAP_NS) {
+		if (tracee->aff_dense < AFF_DENSE_EVENTS)
+			tracee->aff_dense++;
+	} else {
+		tracee->aff_dense = 0;
+		if (tracee->aff_pinned && gap >= AFF_IDLE_NS)
+			unpin(tracee);
+	}
+
+	if (!tracee->aff_pinned && tracee->aff_dense >= AFF_DENSE_EVENTS && now >= retry_after_ns)
+		pin(tracee, true, now);
+}
+
+void nc_aff_on_resume(Tracee *tracee)
+{
+	if (state != 1 || tracee->aff_user)
+		return;
+	tracee->aff_resume_ns = now_ns();
+	if (tracee->aff_pinned)
+		atomic_store(&slots[tracee->aff_slot].resume_ns, tracee->aff_resume_ns);
+}
+
+void nc_aff_forget(Tracee *tracee)
+{
+	if (!tracee->aff_pinned)
+		return;
+	forget_slot(tracee);
+	unpin_tracer_if_idle();
+}
+
+void nc_aff_guest_query(Tracee *target)
+{
+	if (target != NULL)
+		unpin(target);
+}
+
+void nc_aff_guest_set(Tracee *target)
+{
+	if (target == NULL)
+		return;
+	/* Restore the full mask first: if the kernel rejects the guest's
+	 * mask, the tracee must not keep the pin.  */
+	unpin(target);
+	target->aff_user = true;
+}
+
+#endif /* NATIVECODE_PROOT_AFFINITY */
