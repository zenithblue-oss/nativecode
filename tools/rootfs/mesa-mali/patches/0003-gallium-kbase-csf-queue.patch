+static const struct drm_panthor_csif_info *
+csf_get_csif_props(const struct panfrost_device *dev)
+{
+#ifdef HAVE_PAN_KMOD_KBASE
+   if (panfrost_device_is_kbase(dev))
+      return kbase_kmod_get_csif_props(dev->kmod.dev);
+#endif
+   return panthor_kmod_get_csif_props(dev->kmod.dev);
+}
+
+static uint32_t
+csf_get_flush_id(const struct panfrost_device *dev)
+{
+#ifdef HAVE_PAN_KMOD_KBASE
+   if (panfrost_device_is_kbase(dev))
+      return kbase_kmod_get_flush_id(dev->kmod.dev);
+#endif
+   return panthor_kmod_get_flush_id(dev->kmod.dev);
+}
+
+#ifdef HAVE_PAN_KMOD_KBASE
+
+#define PANFROST_KBASE_RINGBUF_SIZE (64 * 1024)
+#define PANFROST_KBASE_RING_JOB_MAX_SIZE 512
+#define PANFROST_KBASE_WAIT_TIMEOUT_NS (10ll * 1000000000ll)
+
+static inline void
+panfrost_kbase_gpu_wmb(void)
+{
+#if defined(__aarch64__)
+   __asm__ volatile("dsb sy" ::: "memory");
+#else
+   __sync_synchronize();
+#endif
+}
+
+static void
+panfrost_kbase_cache_clean_range(const void *start, size_t size)
+{
+   if (!start || !size)
+      return;
+#if defined(__aarch64__)
+   uintptr_t p = (uintptr_t)start & ~(uintptr_t)63;
+   uintptr_t end = (uintptr_t)start + size;
+   for (; p < end; p += 64)
+      __asm__ volatile("dc cvac, %0" ::"r"(p) : "memory");
+#endif
+   panfrost_kbase_gpu_wmb();
+}
+
+static void
+panfrost_kbase_cache_invalidate_range(const void *start, size_t size)
+{
+   if (!start || !size)
+      return;
+#if defined(__aarch64__)
+   uintptr_t p = (uintptr_t)start & ~(uintptr_t)63;
+   uintptr_t end = (uintptr_t)start + size;
+   for (; p < end; p += 64)
+      __asm__ volatile("dc civac, %0" ::"r"(p) : "memory");
+#endif
+   panfrost_kbase_gpu_wmb();
+}
+
+static int
+panfrost_kbase_emit_call(struct panfrost_context *ctx, uint64_t stream_addr,
+                         uint32_t stream_size)
+{
+   struct panfrost_device *dev = pan_device(ctx->base.screen);
+   const struct drm_panthor_csif_info *csif_info = csf_get_csif_props(dev);
+   struct panfrost_csf_context *csf = &ctx->csf;
+   uint32_t offset = csf->kbase.insert % PANFROST_KBASE_RINGBUF_SIZE;
+
+   if (offset + PANFROST_KBASE_RING_JOB_MAX_SIZE > PANFROST_KBASE_RINGBUF_SIZE) {
+      memset((uint8_t *)csf->kbase.ring_bo->ptr.cpu + offset, 0,
+             PANFROST_KBASE_RINGBUF_SIZE - offset);
+      panfrost_kbase_cache_clean_range(
+         (uint8_t *)csf->kbase.ring_bo->ptr.cpu + offset,
+         PANFROST_KBASE_RINGBUF_SIZE - offset);
+      csf->kbase.insert += PANFROST_KBASE_RINGBUF_SIZE - offset;
+      offset = 0;
+   }
+
+   struct cs_buffer ring_buf = {
+      .cpu = (uint64_t *)((uint8_t *)csf->kbase.ring_bo->ptr.cpu + offset),
+      .gpu = csf->kbase.ring_bo->ptr.gpu + offset,
+      .capacity = PANFROST_KBASE_RING_JOB_MAX_SIZE / sizeof(uint64_t),
+   };
+   const struct cs_builder_conf conf = {
+      .nr_registers = csif_info->cs_reg_count,
+      .ls_sb_slot = 0,
+   };
+   struct cs_builder b;
+
+   cs_builder_init(&b, &conf, ring_buf);
+
+#if PAN_ARCH >= 11
+   cs_set_state_imm32(&b, MALI_CS_SET_STATE_TYPE_SB_SEL_ENDPOINT, 0);
+   cs_set_state_imm32(&b, MALI_CS_SET_STATE_TYPE_SB_MASK_WAIT, BITFIELD_BIT(0));
+   cs_set_state_imm32(&b, MALI_CS_SET_STATE_TYPE_SB_SEL_OTHER, PANFROST_SB_LS);
+   cs_set_state_imm32(&b, MALI_CS_SET_STATE_TYPE_SB_SEL_DEFERRED,
+                      PANFROST_SB_DEFERRED);
+   cs_set_state_imm32(&b, MALI_CS_SET_STATE_TYPE_SB_MASK_STREAM,
+                      BITFIELD_MASK(8) & ~BITFIELD_BIT(0));
+#else
+   cs_set_scoreboard_entry(&b, 0, 0);
+#endif
+
+   cs_req_res(&b, CS_COMPUTE_RES | CS_TILER_RES | CS_IDVS_RES | CS_FRAG_RES);
+
+   uint32_t reg = csif_info->cs_reg_count - 4;
+   struct cs_index addr64 = {
+      .type = CS_INDEX_REGISTER,
+      .size = 2,
+      .reg = reg,
+   };
+   struct cs_index val32 = {
+      .type = CS_INDEX_REGISTER,
+      .size = 1,
+      .reg = reg + 2,
+   };
+   struct cs_index val64 = {
+      .type = CS_INDEX_REGISTER,
+      .size = 2,
+      .reg = reg + 2,
+   };
+   uint64_t target = csf->kbase.seqno + 1;
+
+   if (csf->kbase.heap_ctx_va) {
+      cs_move64_to(&b, addr64, csf->kbase.heap_ctx_va);
+      cs_heap_set(&b, addr64);
+   }
+
+   if (stream_size) {
+      cs_move32_to(&b, val32, csf_get_flush_id(dev));
+      cs_flush_caches(&b, MALI_CS_FLUSH_MODE_CLEAN_AND_INVALIDATE,
+                      MALI_CS_FLUSH_MODE_CLEAN_AND_INVALIDATE,
+                      MALI_CS_OTHER_FLUSH_MODE_INVALIDATE, val32,
+                      cs_defer(0, PANFROST_SB_AUX));
+      cs_wait_slot(&b, PANFROST_SB_AUX);
+      cs_move64_to(&b, addr64, stream_addr);
+      cs_move32_to(&b, val32, stream_size);
+      cs_call(&b, addr64, val32);
+   }
+
+   cs_move64_to(&b, addr64, csf->kbase.sync_gpu);
+   cs_wait_slots(&b, BITFIELD_MASK(8));
+   cs_move64_to(&b, val64, target);
+   cs_store64(&b, val64, addr64, 16);
+   cs_wait_slot(&b, PANFROST_SB_LS);
+   cs_move64_to(&b, val64, 1);
+   cs_sync64_add(&b, true, MALI_CS_SYNC_SCOPE_SYSTEM, val64, addr64,
+                 cs_defer(0, PANFROST_SB_DEFERRED));
+   cs_error_barrier(&b);
+   cs_end(&b);
+
+   if (!cs_is_valid(&b))
+      return -1;
+
+   uint32_t entry_size = cs_root_chunk_size(&b);
+   uint32_t padded = ALIGN_POT(entry_size, 64);
+   if (padded != entry_size) {
+      memset((uint8_t *)csf->kbase.ring_bo->ptr.cpu + offset + entry_size, 0,
+             padded - entry_size);
+   }
+   panfrost_kbase_cache_clean_range(
+      (uint8_t *)csf->kbase.ring_bo->ptr.cpu + offset, padded);
+   csf->kbase.insert += padded;
+   csf->kbase.seqno = target;
+   return 0;
+}
+
+static int
+panfrost_kbase_publish_and_kick(struct panfrost_context *ctx)
+{
+   struct panfrost_device *dev = pan_device(ctx->base.screen);
+   uint8_t *input_page = (uint8_t *)ctx->csf.kbase.user_io + 4096;
+   uint8_t *output_page = (uint8_t *)ctx->csf.kbase.user_io + 8192;
+   volatile uint32_t *active =
+      (volatile uint32_t *)(output_page + CS_USER_IO_OUTPUT_CS_ACTIVE);
+
+   panfrost_kbase_gpu_wmb();
+   *(volatile uint64_t *)(input_page + CS_USER_IO_INPUT_CS_INSERT) =
+      ctx->csf.kbase.insert;
+   panfrost_kbase_gpu_wmb();
+   if (*active) {
+      *(volatile uint32_t *)ctx->csf.kbase.user_io = 1;
+      panfrost_kbase_gpu_wmb();
+      if (*active)
+         return 0;
+   }
+   return kbase_kmod_csf_queue_kick(dev->kmod.dev,
+                                    ctx->csf.kbase.ring_bo->ptr.gpu);
+}
+
+static int
+panfrost_kbase_wait_seqno(struct panfrost_context *ctx, uint64_t target)
+{
+   struct panfrost_device *dev = pan_device(ctx->base.screen);
+   volatile uint64_t *seq = ctx->csf.kbase.sync_cpu;
+   volatile uint64_t *ls_copy =
+      (volatile uint64_t *)((uint8_t *)ctx->csf.kbase.sync_cpu + 16);
+   int64_t start = os_time_get_nano();
+   uint64_t deadline = (uint64_t)start + PANFROST_KBASE_WAIT_TIMEOUT_NS;
+   int64_t last_kick = start;
+
+   while (true) {
+      panfrost_kbase_cache_invalidate_range(ctx->csf.kbase.sync_cpu, 64);
+      if (*seq >= target || *ls_copy >= target)
+         return 0;
+      if (kbase_kmod_csf_has_error(dev->kmod.dev)) {
+         mesa_loge("panfrost kbase: queue group error");
+         return -1;
+      }
+
+      int64_t now = os_time_get_nano();
+      if (now - last_kick > 500ll * 1000000ll) {
+         kbase_kmod_csf_queue_kick(dev->kmod.dev,
+                                   ctx->csf.kbase.ring_bo->ptr.gpu);
+         last_kick = now;
+      }
+      if ((uint64_t)now >= deadline) {
+         mesa_loge("panfrost kbase: wait timeout seqno %" PRIu64
+                   " target %" PRIu64,
+                   (uint64_t)*seq, target);
+         return -1;
+      }
+
+      int64_t remaining =
+         MIN2(deadline - (uint64_t)now, 20ull * 1000000ull);
+      int cqs = kbase_kmod_csf_wait_cqs64(dev->kmod.dev, ctx->csf.kbase.sync_gpu,
+                                          target - 1, remaining);
+      if (cqs < 0)
+         kbase_kmod_csf_wait_event(dev->kmod.dev, remaining);
+   }
+}
+
+static int
+panfrost_kbase_submit_cs(struct panfrost_context *ctx, uint64_t cs_start,
+                         uint32_t cs_size)
+{
+   int ret;
+
+   if (ctx->is_noop)
+      return 0;
+   ret = panfrost_kbase_emit_call(ctx, cs_start, cs_size);
+   if (ret)
+      return ret;
+   ret = panfrost_kbase_publish_and_kick(ctx);
+   if (ret)
+      return errno ? errno : ret;
+   return panfrost_kbase_wait_seqno(ctx, ctx->csf.kbase.seqno);
+}
+
+static void
+panfrost_kbase_destroy_queue(struct panfrost_context *ctx)
+{
+   struct panfrost_device *dev = pan_device(ctx->base.screen);
+
+   if (ctx->csf.kbase.user_io && ctx->csf.kbase.ring_bo) {
+      kbase_kmod_csf_queue_term(dev->kmod.dev, ctx->csf.kbase.ring_bo->ptr.gpu,
+                                ctx->csf.kbase.user_io);
+      ctx->csf.kbase.user_io = NULL;
+   }
+   if (ctx->csf.kbase.heap_ctx_va) {
+      kbase_kmod_csf_tiler_heap_destroy(dev->kmod.dev,
+                                        ctx->csf.kbase.heap_ctx_va);
+      ctx->csf.kbase.heap_ctx_va = 0;
+   }
+   if (ctx->csf.group_handle != UINT32_MAX) {
+      kbase_kmod_csf_group_destroy(dev->kmod.dev, ctx->csf.group_handle);
+      ctx->csf.group_handle = UINT32_MAX;
+   }
+   if (ctx->csf.kbase.sync_bo) {
+      pan_kmod_bo_put(ctx->csf.kbase.sync_bo);
+      ctx->csf.kbase.sync_bo = NULL;
+      ctx->csf.kbase.sync_cpu = NULL;
+      ctx->csf.kbase.sync_gpu = 0;
+   }
+   panfrost_bo_unreference(ctx->csf.kbase.ring_bo);
+   ctx->csf.kbase.ring_bo = NULL;
+}
+
+static int
+panfrost_kbase_create_queue(struct panfrost_context *ctx)
+{
+   struct panfrost_device *dev = pan_device(ctx->base.screen);
+
+   ctx->csf.group_handle = UINT32_MAX;
+   if (kbase_kmod_csf_group_create(dev->kmod.dev, 1, &ctx->csf.group_handle))
+      return -1;
+
+   ctx->csf.kbase.ring_bo =
+      panfrost_bo_create(dev, PANFROST_KBASE_RINGBUF_SIZE, 0, "Kbase CS ring");
+   if (!ctx->csf.kbase.ring_bo)
+      goto fail;
+
+   ctx->csf.kbase.user_io = kbase_kmod_csf_queue_bind(
+      dev->kmod.dev, ctx->csf.group_handle, 0, ctx->csf.kbase.ring_bo->ptr.gpu,
+      PANFROST_KBASE_RINGBUF_SIZE);
+   if (!ctx->csf.kbase.user_io)
+      goto fail;
+
+   ctx->csf.kbase.sync_bo = pan_kmod_bo_alloc(dev->kmod.dev, dev->kmod.vm, 4096,
+                                             PAN_KMOD_BO_FLAG_CSF_EVENT);
+   if (!ctx->csf.kbase.sync_bo)
+      goto fail;
+
+   ctx->csf.kbase.sync_cpu = pan_kmod_bo_mmap(
+      ctx->csf.kbase.sync_bo, PROT_READ | PROT_WRITE, MAP_SHARED, NULL);
+   if (ctx->csf.kbase.sync_cpu == MAP_FAILED) {
+      ctx->csf.kbase.sync_cpu = NULL;
+      goto fail;
+   }
+
+   struct pan_kmod_vm_op op = {
+      .type = PAN_KMOD_VM_OP_TYPE_MAP,
+      .va =
+         {
+            .start = PAN_KMOD_VM_MAP_AUTO_VA,
+            .size = 4096,
+         },
+      .map =
+         {
+            .bo = ctx->csf.kbase.sync_bo,
+            .bo_offset = 0,
+         },
+   };
+   if (pan_kmod_vm_bind(dev->kmod.vm, PAN_KMOD_VM_OP_MODE_IMMEDIATE, &op, 1))
+      goto fail;
+
+   ctx->csf.kbase.sync_gpu = op.va.start;
+   memset(ctx->csf.kbase.sync_cpu, 0, 4096);
+   panfrost_kbase_cache_clean_range(ctx->csf.kbase.sync_cpu, 4096);
+   ctx->csf.kbase.insert = 0;
+   ctx->csf.kbase.seqno = 0;
+   return 0;
+
+fail:
+   panfrost_kbase_destroy_queue(ctx);
+   return -1;
+}
