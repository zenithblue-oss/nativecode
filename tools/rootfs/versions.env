# NativeCode prebuilt rootfs — pinned versions (single source of truth).
# Sourced by build_alpine_rootfs.sh / build_alpaquita_rootfs.sh / verify_rootfs.sh / measure_rootfs.sh.
# No `latest` allowed in release builds.

ROOTFS_DISTRO=${ROOTFS_DISTRO:-alpaquita}
ROOTFS_LIBC=${ROOTFS_LIBC:-glibc}
ROOTFS_ARCH=aarch64

# Alpaquita glibc / AArch64 configuration
ALPAQUITA_RELEASE=stream
ALPAQUITA_VERSION=stream
ALPAQUITA_MINIROOTFS_URL=https://packages.bell-sw.com/alpaquita/glibc/stream/alpaquita-minirootfs-stream-latest-glibc-aarch64.tar.gz
# Exact SHA256 of /home/user/Downloads/alpaquita-minirootfs-stream-latest-glibc-aarch64.tar.gz
ALPAQUITA_MINIROOTFS_SHA256=ec5c81cb32bd6454a778aaec449ef269806d7f17b52432abe00280684136af50

ALPAQUITA_REPOS_CORE=https://packages.bell-sw.com/alpaquita/glibc/stream/core
ALPAQUITA_REPOS_UNIVERSE=https://packages.bell-sw.com/alpaquita/glibc/stream/universe

# Alpine 3.24 legacy/rollback configuration
ALPINE_BRANCH=3.24
ALPINE_VERSION=3.24.1
ALPINE_ARCH=aarch64
ALPINE_MINIROOTFS_URL=https://dl-cdn.alpinelinux.org/alpine/v3.24/releases/aarch64/alpine-minirootfs-3.24.1-aarch64.tar.gz
ALPINE_MINIROOTFS_SHA256=REPLACE_ME

APK_REPOS_MAIN=https://dl-cdn.alpinelinux.org/alpine/v3.24/main
APK_REPOS_COMMUNITY=https://dl-cdn.alpinelinux.org/alpine/v3.24/community

NODE_MAJOR=24

# Android / JVM (minimal suite — no Flutter, no SDK 34/35, no NDK 27)
ANDROID_CMDLINE_TOOLS_VERSION=15859902
ANDROID_PLATFORM=36
ANDROID_BUILD_TOOLS=36.1.0
ANDROID_NDK=29.0.14206865
KOTLIN_VERSION=2.1.0
GRADLE_VERSION=9.2.1
JDK_PACKAGE=liberica21-jdk

# AI CLIs versioning:
# Pinned NPM packages (immutable versions)
OPENCODE_VERSION=1.18.27
CODEX_VERSION=0.153.2
QWEN_VERSION=0.23.0

# Upstream installer endpoints (mutable network scripts tracked by URL).
# Note: For strict reproducible production releases, vendors must provide
# immutable pinned artifacts or checksums.
AGY_INSTALLER_URL=https://antigravity.google/cli/install.sh
CLAUDE_INSTALLER_URL=https://claude.ai/install.sh
GROK_INSTALLER_URL=https://x.ai/cli/install.sh
KIRO_INSTALLER_URL=https://cli.kiro.dev/install

BUILD_ID=${BUILD_ID:-$(date -u +%Y.%m.%d.1)}
FORMAT_VERSION=1
