{
    "name": "nc-obsidian",
    "settings": [
        { "settings": { "background": "#0A0A0A", "foreground": "#E5E2E1", "lineHighlight": "#161616", "selection": "#2D5942", "highlightedDelimitersForeground": "#60F99E" } },
        { "name": "Comment", "scope": "comment,punctuation.definition.comment", "settings": { "foreground": "#6B7A6E", "fontStyle": "italic" } },
        { "name": "String", "scope": "string,string.quoted,string.template", "settings": { "foreground": "#9CE8B5" } },
        { "name": "Escape", "scope": "constant.character.escape,string.character.escape", "settings": { "foreground": "#FFB175" } },
        { "name": "Number", "scope": "constant.numeric", "settings": { "foreground": "#FFD6BA" } },
        { "name": "Language constant", "scope": "constant.language,variable.language,constant.other", "settings": { "foreground": "#FFB175" } },
        { "name": "Keyword", "scope": "keyword,storage,storage.type,storage.modifier,keyword.control", "settings": { "foreground": "#60F99E", "fontStyle": "bold" } },
        { "name": "Operator", "scope": "keyword.operator", "settings": { "foreground": "#BBCBBC" } },
        { "name": "Function", "scope": "entity.name.function,support.function,meta.function-call", "settings": { "foreground": "#8FD3FF" } },
        { "name": "Type", "scope": "entity.name.type,entity.name.class,support.type,support.class,entity.other.inherited-class", "settings": { "foreground": "#FFD6BA" } },
        { "name": "Tag", "scope": "entity.name.tag,markup.heading", "settings": { "foreground": "#60F99E" } },
        { "name": "Attribute", "scope": "entity.other.attribute-name,support.type.property-name,meta.object-literal.key", "settings": { "foreground": "#8FD3FF" } },
        { "name": "Variable", "scope": "variable,variable.parameter", "settings": { "foreground": "#E5E2E1" } },
        { "name": "Annotation", "scope": "storage.type.annotation,meta.annotation,entity.name.function.decorator", "settings": { "foreground": "#C8A2FF" } },
        { "name": "Markup bold", "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
        { "name": "Markup italic", "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "name": "Link", "scope": "markup.underline.link,string.other.link", "settings": { "foreground": "#8FD3FF" } },
        { "name": "Invalid", "scope": "invalid", "settings": { "foreground": "#FFB4AB" } }
    ]
}
