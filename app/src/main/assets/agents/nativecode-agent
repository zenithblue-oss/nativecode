#!/usr/bin/env python3
"""
nativecode-agent: CLI helper for PRoot guest scripts and agents to communicate
with the NativeCode Android host application via AF_UNIX abstract namespace.
"""

import argparse
import json
import os
import socket
import struct
import sys

RENDEZVOUS_PATHS = [
    "/run/nativecode_bridge.json",
    os.path.expanduser("~/.nativecode_bridge.json")
]

def find_rendezvous():
    for p in RENDEZVOUS_PATHS:
        if os.path.exists(p):
            try:
                with open(p, "r") as f:
                    return json.load(f)
            except Exception:
                pass
    return None

def connect_agent_socket(override_socket=None, override_uid=None):
    candidates = []
    if override_socket:
        candidates.append(override_socket)
    if override_uid:
        candidates.append(f"@nativecode.agent.v1.{override_uid}")

    # Primary well-known abstract socket
    candidates.append("@nativecode.agent.v1")

    rendezvous = find_rendezvous()
    if rendezvous and "agent_socket" in rendezvous:
        candidates.append(rendezvous["agent_socket"])
    if rendezvous and "host_uid" in rendezvous:
        candidates.append(f"@nativecode.agent.v1.{rendezvous['host_uid']}")

    for sock_name in candidates:
        if sock_name.startswith("@"):
            addr = "\0" + sock_name[1:]
        elif sock_name.startswith("\0"):
            addr = sock_name
        else:
            addr = sock_name

        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        try:
            s.connect(addr)
            return s
        except Exception:
            s.close()

    sys.stderr.write("Error: Could not connect to NativeCode agent bridge. Is NativeCode running?\n")
    sys.exit(1)

def recv_exact(sock, n):
    buf = bytearray()
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            raise ConnectionError("Server closed connection prematurely")
        buf.extend(chunk)
    return bytes(buf)

def send_request(sock, req_dict):
    data = json.dumps(req_dict).encode("utf-8")
    header = struct.pack(">I", len(data))
    sock.sendall(header + data)

    # Read length prefix
    resp_header = recv_exact(sock, 4)
    resp_len = struct.unpack(">I", resp_header)[0]
    resp_data = recv_exact(sock, resp_len)
    return json.loads(resp_data.decode("utf-8"))

def main():
    parser = argparse.ArgumentParser(description="NativeCode Agent Host Bridge CLI")
    parser.add_argument("--socket", help="Override abstract socket name (e.g. @nativecode.agent.v1.10123)")
    parser.add_argument("--host-uid", type=int, help="Override host app UID")

    subparsers = parser.add_subparsers(dest="cmd", required=True)

    # ping
    subparsers.add_parser("ping", help="Ping the NativeCode host application")

    # notify
    notify_p = subparsers.add_parser("notify", help="Post an Android notification")
    notify_p.add_argument("--title", required=True, help="Notification title")
    notify_p.add_argument("--message", required=True, help="Notification body message")
    notify_p.add_argument("--id", type=int, default=1001, help="Notification ID")
    notify_p.add_argument("--tag", default="agent_task", help="Notification tag")
    notify_p.add_argument("--priority", default="default", choices=["default", "high", "low"])
    def parse_bool_or_flag(v):
        if isinstance(v, bool):
            return v
        return str(v).strip().lower() not in ("false", "0", "no", "off")

    notify_p.add_argument("--ongoing", nargs="?", const=True, default=False, type=parse_bool_or_flag, help="Set ongoing notification (flag or true/false)")

    # status
    status_p = subparsers.add_parser("status", help="Update ongoing task status in notification shade")
    status_p.add_argument("--text", required=True, help="Status description")
    status_p.add_argument("--key", default="agent_task", help="Status key / tag")
    status_p.add_argument("--progress", type=int, default=-1, help="Progress percentage (0-100) or -1 for indeterminate")

    # toast
    toast_p = subparsers.add_parser("toast", help="Show transient Toast on Android screen")
    toast_p.add_argument("--text", required=True, help="Toast message text")

    # telemetry
    subparsers.add_parser("telemetry", help="Query host battery, thermals, and memory")

    # open-link
    open_link_p = subparsers.add_parser("open-link", help="Request host app to show link alert / open in default browser")
    open_link_p.add_argument("--url", required=True, help="URL to open (e.g. http://localhost:3000)")
    open_link_p.add_argument("--title", default="Agent Web Link", help="Dialog / notification title")
    open_link_p.add_argument("--message", default="", help="Message text")

    open_url_p = subparsers.add_parser("open-url", help="Alias for open-link")
    open_url_p.add_argument("--url", required=True, help="URL to open (e.g. http://localhost:3000)")
    open_url_p.add_argument("--title", default="Agent Web Link", help="Dialog / notification title")
    open_url_p.add_argument("--message", default="", help="Message text")

    # install-apk
    install_apk_p = subparsers.add_parser("install-apk", help="Request host app to show APK install / export card")
    install_apk_p.add_argument("--path", required=True, help="Path to APK file")
    install_apk_p.add_argument("--title", default="Install APK", help="Dialog / notification title")
    install_apk_p.add_argument("--message", default="", help="Message text")

    open_apk_p = subparsers.add_parser("open-apk", help="Alias for install-apk")
    open_apk_p.add_argument("--path", required=True, help="Path to APK file")
    open_apk_p.add_argument("--title", default="Install APK", help="Dialog / notification title")
    open_apk_p.add_argument("--message", default="", help="Message text")

    # share-file / send-file
    for name in ("share-file", "send-file"):
        share_p = subparsers.add_parser(name, help="Offer a file to the user (share sheet / save)")
        share_p.add_argument("pos_path", nargs="?", metavar="PATH", help="Path to the file (or use --path)")
        share_p.add_argument("--path", help="Path to the file")
        share_p.add_argument("--title", default="", help="Card / notification title (default: file name)")
        share_p.add_argument("--message", default="", help="Message text")

    # dismiss-alert / cancel-alert
    subparsers.add_parser("dismiss-alert", help="Dismiss any active on-screen alert card (open-link or install-apk)")
    subparsers.add_parser("cancel-alert", help="Alias for dismiss-alert")
    subparsers.add_parser("dismiss", help="Alias for dismiss-alert")

    args = parser.parse_args()
    sock = connect_agent_socket(args.socket, args.host_uid)

    try:
        if args.cmd == "ping":
            req = {"v": 1, "cmd": "ping", "client_id": "agent-cli"}
        elif args.cmd == "notify":
            req = {
                "v": 1,
                "cmd": "notify",
                "title": args.title,
                "message": args.message,
                "id": args.id,
                "tag": args.tag,
                "priority": args.priority,
                "ongoing": args.ongoing
            }
        elif args.cmd == "status":
            req = {
                "v": 1,
                "cmd": "status",
                "text": args.text,
                "key": args.key,
                "progress": args.progress
            }
        elif args.cmd == "toast":
            req = {
                "v": 1,
                "cmd": "toast",
                "text": args.text
            }
        elif args.cmd == "telemetry":
            req = {"v": 1, "cmd": "telemetry"}
        elif args.cmd in ("open-link", "open-url"):
            req = {
                "v": 1,
                "cmd": "open_link",
                "url": args.url,
                "title": args.title,
                "message": args.message
            }
        elif args.cmd in ("install-apk", "open-apk"):
            apk_path = os.path.abspath(os.path.expanduser(args.path))
            if not os.path.exists(apk_path):
                print(json.dumps({"v": 1, "ok": False, "error": f"APK file not found: {args.path}"}, indent=2))
                sys.exit(1)
            if os.path.getsize(apk_path) < 100:
                print(json.dumps({"v": 1, "ok": False, "error": f"Invalid APK file (size too small or empty): {args.path}"}, indent=2))
                sys.exit(1)
            req = {
                "v": 1,
                "cmd": "install_apk",
                "path": apk_path,
                "title": args.title,
                "message": args.message
            }
        elif args.cmd in ("share-file", "send-file"):
            raw_path = args.path or args.pos_path
            if not raw_path:
                print(json.dumps({"v": 1, "ok": False, "error": "Missing file path: nativecode-agent share-file <path>"}, indent=2))
                sys.exit(1)
            file_path = os.path.abspath(os.path.expanduser(raw_path))
            if not os.path.isfile(file_path):
                print(json.dumps({"v": 1, "ok": False, "error": f"File not found: {raw_path}"}, indent=2))
                sys.exit(1)
            req = {"v": 1, "cmd": "share_file", "path": file_path, "title": args.title, "message": args.message}
        elif args.cmd in ("dismiss-alert", "cancel-alert", "dismiss"):
            req = {"v": 1, "cmd": "dismiss_alert"}
        else:
            sys.exit(1)

        resp = send_request(sock, req)
        print(json.dumps(resp, indent=2))
        if not resp.get("ok", False):
            sys.exit(1)
    finally:
        sock.close()

if __name__ == "__main__":
    main()
