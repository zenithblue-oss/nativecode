bytes: number,\\n      state: \\\"pending\\\" | \\\"completed\\\" | \\\"failed\\\",\\n    }>,\\n}>\"},{\"path\":\"tools.browser.network.list\",\"description\":\"List this tab's captured requests. urlContains is a literal case-sensitive substring. Use exact returned request IDs; HTTP 4xx/5xx is completed, not a transport failure.\",\"signature\":\"tools.browser.network.list({\\n  /**\\n   * Exact tab ID returned by browser.tabs.open/list. Focus does not select a tool target.\\n   * @pattern ^tab_[a-f0-9-]{36}$\\n   */\\n  tabID: string,\\n  /** @maxLength 2048 */\\n  urlContains?: string,\\n  resourceType?: \\\"document\\\" | \\\"stylesheet\\\" | \\\"image\\\" | \\\"media\\\" | \\\"font\\\" | \\\"script\\\" | \\\"xhr\\\" | \\\"fetch\\\" | \\\"eventsource\\\" | \\\"websocket\\\" | \\\"manifest\\\" | \\\"other\\\",\\n  /** @integer @minimum 1 @maximum 500 */\\n  limit?: number,\\n}): Promise<{\\n  tab: {\\n    /** @pattern ^tab_[a-f0-9-]{36}$ */\\n    id: string,\\n    /** @maxLength 16384 */\\n    url: string,\\n    /** @maxLength 2048 */\\n    title: string,\\n    loading: boolean,\\n    /** @maxLength 2048 */\\n    loadError?: string,\\n    canGoBack: boolean,\\n    canGoForward: boolean,\\n    /** @integer @minimum 0 */\\n    generation: number,\\n  },\\n  requests: Array<{\\n        /** @maxLength 2048 */\\n        id: string,\\n        /** @maxLength 100000 */\\n        url: string,\\n        /** @maxLength 2048 */\\n        method: string,\\n        resourceType: \\\"document\\\" | \\\"stylesheet\\\" | \\\"image\\\" | \\\"media\\\" | \\\"font\\\" | \\\"script\\\" | \\\"xhr\\\" | \\\"fetch\\\" | \\\"eventsource\\\" | \\\"websocket\\\" | \\\"manifest\\\" | \\\"other\\\",\\n        timestampMs: number,\\n        /** @integer @minimum 0 */\\n        statusCode?: number,\\n        state: \\\"pending\\\",\\n      } | {\\n        /** @maxLength 2048 */\\n        id: string,\\n        /** @maxLength 100000 */\\n        url: string,\\n        /** @maxLength 2048 */\\n   