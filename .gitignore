# Ignore Gradle project-specific cache directory
.gradle
.gradle_home/

# Ignore Gradle build output directory
build

# Ignore local properties (sensitive SDK locations)
local.properties
key.properties
*.jks
*.keystore
# Firebase config (local only)
app/google-services.json

# Ignore large bootstrap assets and packaging roots
bootstrap.tar
bootstrap_root/
tools/rootfs/out/
tools/rootfs/mesa-adreno/cache/
tools/rootfs/mesa-adreno/out/
*.tar.zst
nativecode_android_dev/src/main/assets/*.tar.xz
nativecode_update_core/src/main/assets/*.tgz
# NOTE (Play release): before ./gradlew bundleRelease, stage the prebuilt
# runtime into the on-demand asset pack (stays local, NOT committed):
#   cp tools/rootfs/out/alpaquita_rootfs.tar.zst{,.sha256} nativecode_runtime/src/main/assets/
# Only the .sha256 pin is committed; the 1.4 GB blob is a local build input.
# Pinned Debian rootfs shipped in APK assets (local/CI place under assets/rootfs/)
app/src/main/assets/rootfs/*.tar.xz
debian_13_rootfs.tar.xz
termux-packages/*
!termux-packages/output/
!termux-packages/output/**

# Ignore IDE, agent, and memory logs
.claude/
.serena/
.agents/
.tokensave/
*.hprof
*.png
!app/src/main/res/**/*.png
!app/src/main/assets/images/**/*.png
!app/src/main/assets/xfce/**/*.png
